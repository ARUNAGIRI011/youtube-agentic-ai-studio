# AI Vidro Automation Pipeline — Environment Variables
# Copy this file to .env and fill in your keys.
# The app reads these automatically (config.py uses os.getenv).

GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Pixabay first-choice provider; Openverse fallback requires no key
PIXABAY_API_KEY=your_pixabay_api_key_here

# Optional: set to 0.0.0.0 only to access this Windows host from your Android device on a trusted LAN
AI_VIDRO_HOST=127.0.0.1

# Optional — only needed if using ElevenLabs TTS instead of Edge TTS
ELEVENLABS_API_KEY=your_elevenlabs_key_here
